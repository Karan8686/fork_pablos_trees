From 445688be5f6983ee3df0400aa803e4894c2fdf2e Mon Sep 17 00:00:00 2001
From: Karan <kpalav098@gmail.com>
Date: Mon, 24 Aug 2026 08:55:29 +0000
Subject: [PATCH] marble: Add custom Axion device changes

---
 BoardConfig.mk                |  2 ++
 configs/ax_kernel_manager.xml | 34 ++++++++++++++++++++++++++++++++++
 device.mk                     |  7 ++++++-
 lineage_marble.mk             |  2 +-
 sepolicy/vendor/genfscon      |  4 ++++
 5 files changed, 47 insertions(+), 2 deletions(-)
 create mode 100644 configs/ax_kernel_manager.xml
 create mode 100644 sepolicy/vendor/genfscon

diff --git a/BoardConfig.mk b/BoardConfig.mk
index a252284..3e28e30 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -34,3 +34,5 @@ TARGET_VENDOR_PROP += $(DEVICE_PATH)/properties/vendor.prop
 
 # Screen density
 TARGET_SCREEN_DENSITY := 440
+
+BOARD_VENDOR_SEPOLICY_DIRS += device/xiaomi/marble/sepolicy/vendor
diff --git a/configs/ax_kernel_manager.xml b/configs/ax_kernel_manager.xml
new file mode 100644
index 0000000..0d8418e
--- /dev/null
+++ b/configs/ax_kernel_manager.xml
@@ -0,0 +1,34 @@
+<?xml version="1.0" encoding="utf-8"?>
+<kernelManagerConfig>
+
+    <cpu
+        id="cpu0"
+        group="little"
+        path="/sys/devices/system/cpu/cpufreq/policy0"
+        minPath="/sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq"
+        maxPath="/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq"
+        availablePath="/sys/devices/system/cpu/cpufreq/policy0/scaling_available_frequencies"
+        governorPath="/sys/devices/system/cpu/cpufreq/policy0/scaling_governor"
+        governorAvailablePath="/sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors" />
+
+    <cpu
+        id="cpu4"
+        group="big"
+        path="/sys/devices/system/cpu/cpufreq/policy4"
+        minPath="/sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq"
+        maxPath="/sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq"
+        availablePath="/sys/devices/system/cpu/cpufreq/policy4/scaling_available_frequencies"
+        governorPath="/sys/devices/system/cpu/cpufreq/policy4/scaling_governor"
+        governorAvailablePath="/sys/devices/system/cpu/cpufreq/policy4/scaling_available_governors" />
+
+    <cpu
+        id="cpu7"
+        group="prime"
+        path="/sys/devices/system/cpu/cpufreq/policy7"
+        minPath="/sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq"
+        maxPath="/sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq"
+        availablePath="/sys/devices/system/cpu/cpufreq/policy7/scaling_available_frequencies"
+        governorPath="/sys/devices/system/cpu/cpufreq/policy7/scaling_governor"
+        governorAvailablePath="/sys/devices/system/cpu/cpufreq/policy7/scaling_available_governors" />
+
+</kernelManagerConfig>
diff --git a/device.mk b/device.mk
index 821cafe..b64294d 100644
--- a/device.mk
+++ b/device.mk
@@ -51,7 +51,8 @@ SPAMMY_LOG_TAGS := \
 
 ifneq ($(TARGET_BUILD_VARIANT),eng)
 PRODUCT_VENDOR_PROPERTIES += \
-    $(foreach tag,$(SPAMMY_LOG_TAGS),log.tag.$(tag)=E)
+    $(foreach tag,$(SPAMMY_LOG_TAGS),log.tag.$(tag)=E) \
+    vendor.camera.aux.packageexcludelist=com.adobe.scan.android,com.tencent.mm,us.zoom.videomeetings,in.org.npci.upiapp
 endif
 
 # Overlay
@@ -84,3 +85,7 @@ PRODUCT_COPY_FILES += \
 # Vibrator
 $(call soong_config_set,qti_vibrator,effect_lib,libqtivibratoreffect.xiaomi)
 $(call soong_config_set_bool,qti_vibrator,use_effect_stream,true)
+
+# AxionOS Kernel Manager configuration
+PRODUCT_COPY_FILES += \
+    $(LOCAL_PATH)/configs/ax_kernel_manager.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/ax_kernel_manager.xml
diff --git a/lineage_marble.mk b/lineage_marble.mk
index e1c3a25..c597365 100644
--- a/lineage_marble.mk
+++ b/lineage_marble.mk
@@ -43,7 +43,7 @@ TARGET_INCLUDES_LOS_PREBUILTS := true
 TARGET_NEEDS_VULKAN_MEDIA_FIX := true
 
 # Maintainer name (underscores become spaces in the UI)
-AXION_MAINTAINER := PabloEscobar
+AXION_MAINTAINER := Karan69
 
 # Processor name (underscores become spaces)
 AXION_PROCESSOR := Snapdragon®_7+_Gen_2_(SM7475)
diff --git a/sepolicy/vendor/genfscon b/sepolicy/vendor/genfscon
new file mode 100644
index 0000000..e43c89b
--- /dev/null
+++ b/sepolicy/vendor/genfscon
@@ -0,0 +1,4 @@
+genfscon proc /sys/vm/dirty_writeback_centisecs u:object_r:proc_dirty:s0
+genfscon proc /sys/vm/vfs_cache_pressure u:object_r:proc_drop_caches:s0
+genfscon proc /sys/vm/dirty_ratio u:object_r:proc_dirty:s0
+genfscon proc /sys/kernel/sched_migration_cost_ns u:object_r:proc_sched:s0
-- 
2.43.0

